{
  "name": "docker-update-checker",
  "version": "1.1.0",
  "description": "Modern web interface to check for Docker container updates",
  "main": "src/server.js",
  "scripts": {
    "build": "esbuild frontend/app.jsx --bundle --minify --format=iife --jsx=automatic --outfile=app.js",
    "start": "node src/server.js",
    "dev": "npm run build && nodemon src/server.js",
    "test": "node --test"
  },
  "keywords": [
    "docker",
    "containers",
    "updates",
    "monitor",
    "devops"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "axios": "^1.6.2",
    "cors": "^2.8.5",
    "dockerode": "^4.0.2",
    "express": "^4.18.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "nodemon": "^3.0.2"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
